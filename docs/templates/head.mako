<style>
  :root { --highlight-color: #e5efff; }
  body { color: #202a36; font-family: system-ui, sans-serif; line-height: 1.65; }
  a { color: #185bb3; }
  h1, h2, h3, h4, h5 { color: #172c46; font-weight: 600; }
  #content { max-width: 72rem; }
  #content .desc { max-width: 78ch; }
  #content .desc p { margin: .8em 0; }
  #content .name { background: #f1f5fa; border-left: 3px solid #b5cbe5; padding: .65em; }
  #content code.name { flex-wrap: wrap; overflow-wrap: anywhere; white-space: normal; }
  #content .name .ident { flex-shrink: 0; }
  #content pre { background: #f6f8fb; border: 1px solid #dce3ec; border-radius: 4px; padding: 1em; overflow-x: auto; }
  #content pre code { white-space: pre; }
  #content table { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; }
  #content th, #content td { padding: .55em .8em; border: 1px solid #dce3ec; text-align: left; }
  #content th { background: #f1f5fa; }
  #content dd { margin-left: 1em; }
  #sidebar { background: #f6f8fb; overflow-y: auto; }
  #sidebar code { white-space: normal; overflow-wrap: anywhere; }
  #sidebar h3 { font-size: 1em; }
  #sidebar .toc ul { padding-left: 1em; }
  .project-links { display: flex; flex-wrap: wrap; gap: .7em; margin-bottom: 1.4em; }
  .project-links a { text-decoration: none; font-weight: 600; }
  @media (max-width: 700px) {
    #content { padding: 16px; }
    #content dd { margin-left: .3em; }
    #content .title { font-size: 1.8em; }
  }
</style>
